  {
    "id": "C07_query_rewrite",
    "acceptance": ["改写后的相似问题", "检索改进"],
    "description": "用户用缩写 WFH，知识库写的是“远程办公”，字面检索找不到，需要模型改写查询后找到 D05 并引用其中的 VPN 条款。知识库只写了远程办公要开通 VPN、没写 WFH 本身是否要审批，属于部分可答。v1 没有部分可答的规则，模型在 answered 和 insufficient_evidence 之间摇摆；v2 规定部分可答用 answered、缺失部分写进 gaps，预期收紧为 answered（过程见 docs/03-evaluation.md）。离线 Mock 没有语义改写能力，预期返回资料不足。",
    "turns": [
      {
        "question": "WFH 要先申请什么？",
        "expect": {"status": ["answered"], "cited_docs_include": ["D05"], "answer_contains_any": ["VPN"]},
        "expect_mock": {"status": ["insufficient_evidence"]}
      }
    ]
  },
