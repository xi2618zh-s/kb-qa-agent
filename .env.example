# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。
# 不配置任何变量也能运行：默认使用离线 Mock（只验证流程，不代表真实模型的决策效果）。

# mock | openai（openai = 任意 OpenAI 兼容接口，如 DeepSeek、通义千问）
LLM_PROVIDER=openai

# ---- DeepSeek ----
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ---- 通义千问（DashScope 兼容模式），二选一时替换上面三行 ----
# LLM_API_KEY=
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# 单次模型请求超时（秒）
LLM_TIMEOUT=60
